{
    "name": "Anti-HoneyPot[By-MegaVector]",
    "version": "1.0.3",
    "manifest_version": 3,
    "description": "检测WEB蜜罐并拦截跨域JSONP请求，防止红队被溯源真实ID",
    "icons": {
        "128": "/img/logo.png"
    },      
    "action": {
        "default_popup": "popup.html",
        "default_title": "Anti-HoneyPot[By-MegaVector]",
        "default_icon": "./img/logo.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "notifications",
        "activeTab",
        "tabs",
        "storage",
        "webRequest",
        "webRequestBlocking"
        // 移除 alarms 权限（更新检测的定时任务不再需要）
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
        // 移除 GitHub API 相关主机权限
    ],
    "web_accessible_resources": [
        {
            "resources": ["*"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; script-src-elem 'self' 'unsafe-eval'"
    }
}
